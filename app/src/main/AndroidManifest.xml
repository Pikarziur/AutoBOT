<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 基础权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"
        tools:targetApi="34" />
    <!-- Android 11+ 读取手机本地应用列表（用于 App 选择器自由选择其他 App） -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Android 13+ 通知权限：用于前台服务通知显示 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"
        tools:targetApi="33" />

    <!-- ============================================================ -->
    <!-- 以下权限对齐 MAA-Meow，虚拟显示器/Shizuku 场景必要或高度推荐 -->
    <!-- ============================================================ -->
    <!-- 悬浮窗：全屏模式下预览 SurfaceView 和后续扩展功能 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 前台服务运行期间防止 CPU 休眠，避免虚拟显示器画面冻结 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Android 13+ 通知分组相关（Shizuku 前台通知） -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS"
        tools:targetApi="33" />
    <!-- 请求加入电池优化白名单：避免 Shizuku/虚拟显示器进程被系统查杀 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Shizuku 权限 -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <uses-permission android:name="moe.shizuku.manager.permission.API_V11" />
    <uses-permission android:name="rikka.shizuku.permission.API_V30" />

    <!--
        Android 11+ 包可见性：必须在 <queries> 中声明 Shizuku，
        否则 PackageManager.resolveActivity / getLaunchIntentForPackage 会返回 null，
        导致 ShizukuManager.openShizukuApp() 跳转失败。
        这是 MAA-Meow 已有但 AutoBOT 之前缺失的关键配置。
    -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="moe.shizuku.manager" />
        <!-- 厂商自启动引导页（AutoStart 适配） -->
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.oppo.safe" />
        <package android:name="com.vivo.permissionmanager" />
        <package android:name="com.huawei.systemmanager" />
        <package android:name="com.hihonor.systemmanager" />
        <package android:name="com.samsung.android.lool" />
        <package android:name="com.meizu.safe" />
        <package android:name="com.zte.heartyservice" />
        <!-- QUERY_ALL_PACKAGES 兜底 + 启动其他 App 到虚拟显示器 -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".AutoBOTApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AutoBOT"
        android:requestLegacyExternalStorage="true">

        <!--
            Shizuku Provider 配置（必须与 MAA-Meow 完全对齐）
            注意：
              · ShizukuProvider.attachInfo() 内部强制校验 exported==true，
                设为 false 会抛 IllegalStateException 导致 APP 启动即闪退
              · permission=INTERACT_ACROSS_USERS_FULL 防止 Shizuku 内部跨用户权限报错
        -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:exported="true"
            android:multiprocess="false"
            android:enabled="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Shizuku 服务配置：max_parcel_size 1MB，与 MAA-Meow 一致 -->
        <meta-data
            android:name="rikka.shizuku.max_parcel_size"
            android:value="1048576" />

        <!--
            主 Activity：configChanges 声明 smallestScreenSize 避免横竖屏切换重建 Fragment/ViewModel
            ★小窗 / 画中画支持★：
              · supportsPictureInPicture=true：允许进入画中画模式，切到后台/小窗时 VD 仍由
                app 级 CompositionService 单例保活，任务继续执行不被打断
              · resizeableActivity=true：允许分屏/自由窗口调整尺寸，配合 configChanges
                让 Activity 在尺寸变化时不重建，SurfaceView 直接接收新尺寸重绑预览
        -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:theme="@style/Theme.AutoBOT">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 后台任务服务：specialUse 类型为 API 34+ 新增，低版本会被忽略，服务照常启动 -->
        <service
            android:name=".service.TaskService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            tools:targetApi="34">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="background_task_execution"
                tools:targetApi="34" />
        </service>

    </application>
</manifest>
