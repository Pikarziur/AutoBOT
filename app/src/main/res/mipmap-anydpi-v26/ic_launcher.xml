<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 8.0+（API 26+）Adaptive Icon：
    - background = ic_launcher_background.png（各密度 mipmap 提供）
    - foreground = ic_launcher_foreground.png（logo 主体，落在 72dp 安全区）
    - monochrome = ic_launcher_monochrome.png（Android 13+ 主题图标用）
  系统会按设备 mask（圆/圆角方/水滴）自动裁剪。
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
