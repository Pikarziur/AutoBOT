<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive Icon 前景层（108dp × 108dp viewport）
  白色粗体圆角无衬线 "B" 字母，放置在中央 72dp 安全区内（上下左右各留 18dp ≈ 16.6%），
  避免被各厂商 mask（圆 / 方 / squircle / 水滴）裁到字形边缘。

  关键：B 中间的两个"小窗户"用 evenOdd 填充规则真挖空 → 背景层的 135° 蓝紫渐变
       会从窗户里直接透出来，视觉上和用户提供的 PNG 图标完全一致（不会出现
       用纯色填窗口导致的"渐变断档"问题）。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      单 path + evenOdd = 真挖空：
        sub-path 1) B 外层轮廓（顺时针）
        sub-path 2) 上窗口（顺时针，被 evenOdd 规则判定为"内洞"→ 不填色）
        sub-path 3) 下窗口（同上）
    -->
