<?xml version="1.0" encoding="utf-8"?>
<!--
  与用户提供的新图标一致：蓝 → 紫 135° 线性渐变 + 圆角方形（≈26% 圆角）。
  作为 adaptive-icon 的背景层（108dp × 108dp），允许被各厂商的圆形/圆角/水滴 mask 裁剪。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      path = 圆角矩形（与用户 PNG 原图圆角程度一致 ≈ 28/108）
      fillColor 用 aapt:attr 包一层 gradient（Android Vector 原生 gradient 必须通过这种方式注入 fillColor）
    -->
    <path
        android:pathData="
            M28,0
            L80,0
            C95.464,0 108,12.536 108,28
            L108,80
            C108,95.464 95.464,108 80,108
            L28,108
            C12.536,108 0,95.464 0,80
            L0,28
            C0,12.536 12.536,0 28,0
            Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#5FA9FF" />
                <item android:offset="1" android:color="#A27BFF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
