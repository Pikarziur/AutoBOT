<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Material Design 3 白色主题 -->
    <style name="Theme.AutoBOT" parent="Theme.Material3.Light.NoActionBar">
        <!-- 主色：蓝 -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_light</item>
        <!-- 强调色：蓝 -->
        <item name="colorAccent">@color/accent</item>
        <!-- 背景与表面：纯白 -->
        <item name="android:windowBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <!-- 文字色 -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <!-- 错误色 -->
        <item name="colorError">@color/error</item>
        <!-- 状态栏与页面底色一致 → 全面屏效果，深色图标 -->
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- 导航栏（虚拟按键）背景也跟随白色 -->
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <!-- 底部导航文字样式：水平居中 -->
    <style name="BottomNavText" parent="TextAppearance.Material3.Caption">
        <item name="android:textAlignment">center</item>
        <item name="android:gravity">center</item>
    </style>

</resources>
